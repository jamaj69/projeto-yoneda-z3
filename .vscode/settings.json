{
  "cSpell.language": "en,pt,pt-BR",
  "cSpell.enabled": true,
  "cSpell.allowCompoundWords": true,
  "cSpell.enabledFileTypes": {
    "markdown": true,
    "haskell": true,
    "python": true,
    "json": true,
    "yaml": true
  },
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "workspace",
  "python.defaultInterpreterPath": "/home/python/pyenv/bin/python3",
  "python.analysis.extraPaths": [],
  "python.analysis.stubPath": "",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportMissingTypeStubs": "none",
    "reportAttributeAccessIssue": "none",
    "reportOptionalMemberAccess": "none",
    "reportWildcardImportFromLibrary": "none",
    "reportArgumentType": "none"
  },
  "haskell.serverEnvironment": {
    "PATH": "${HOME}/.local/bin:${PATH}"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.stack-work": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.stack-work": true,
    "**/dist": true,
    "**/dist-newstyle": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true
  },
  "ltex.language": "pt-BR",
  "ltex.enabled": [
    "markdown"
  ],
  "ltex.additionalRules.motherTongue": "pt-BR",
  "ltex.dictionary": {
    "pt-BR": [
      "abz5",
      "abz6",
      "abz7",
      "abz8",
      "abz9",
      "ft06",
      "ft10",
      "ft20",
      "la01",
      "la02",
      "la03",
      "MWR",
      "SPT",
      "makespan",
      "jobs",
      "job",
      "lookahead",
      "Hints",
      "Constraints",
      "starvation",
      "baseline",
      "timeout",
      "bound",
      "best",
      "known",
      "Benchmark",
      "Metaheurísticas",
      "Genetic",
      "Algorithm",
      "Simulated",
      "Annealing",
      "Learning",
      "Branch",
      "Bound",
      "Acceleration",
      "Distributed",
      "Solving",
      "workers",
      "Hybrid",
      "Metaheuristics",
      "Panwalkar",
      "Iskander",
      "Survey",
      "of",
      "Scheduling",
      "Various",
      "optimizers",
      "stage",
      "production",
      "JSSP",
      "Complexity",
      "Garey",
      "Computers",
      "and",
      "Intractability",
      "Bjørner",
      "An",
      "Efficient",
      "SMT",
      "hints",
      "gap",
      "Dims",
      "Most",
      "Work",
      "Remaining",
      "Shortest",
      "Processing",
      "Tie",
      "breaking",
      "ready",
      "sort",
      "hard",
      "Cache",
      "duracao"
    ]
  },
  "ltex.disabledRules": {
    "pt-BR": [
      "DASH_RULE",
      "DECIMAL_COMMA",
      "PT_BARBARISMS_REPLACE",
      "HUNSPELL_RULE",
      "INTERNET_ABBREVIATIONS",
      "ABREVIATIONS_PUNCTUATION",
      "SPACES_BETWEEN_OPERATORS",
      "REPEATED_WORDS_3X",
      "BARBARISMS"
    ]
  },
  "terminal.integrated.environmentChangesRelaunch": false,
  "terminal.integrated.environmentChangesIndicator": "off",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    }
  },
  "[python]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[haskell]": {
    "editor.formatOnSave": false
  }
}
